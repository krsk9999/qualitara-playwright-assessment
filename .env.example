# Copy to .env and fill in. .env is gitignored; CI reads these from repository secrets.

# Optional: defaults to https://the-internet.herokuapp.com
# BASE_URL=

# Valid account (published on the /login page itself)
LOGIN_USERNAME=tomsmith
LOGIN_PASSWORD=SuperSecretPassword!

# Values that must NOT match the valid account
LOGIN_INVALID_USERNAME=invalidUser
LOGIN_INVALID_PASSWORD=WrongPassword!

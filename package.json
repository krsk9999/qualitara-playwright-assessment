{
  "name": "qualitara-playwright-assessment",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript E2E suite for the-internet.herokuapp.com",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
